APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Lima
DB_TIMEZONE=America/Lima
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_APP_URL=http://127.0.0.1:5173
FRONTEND_ADMIN_URL=http://127.0.0.1:5174
FRONTEND_ACCESS_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
DEFAULT_COMPANY_RATE_LIMIT_PER_MINUTE=3600
DEFAULT_COMPANY_RATE_LIMIT_WRITE_PER_MINUTE=2400
DEFAULT_COMPANY_RATE_LIMIT_REPORTS_PER_MINUTE=900

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ACCESS_TOKEN_TTL_MINUTES=480
REFRESH_TOKEN_TTL_DAYS=60

# Observability controls (safe defaults to avoid log noise in production)
OPS_CAPTURE_ENDPOINT_LATENCY=false
OPS_LOG_SLOW_SQL=false
OPS_SLOW_SQL_MS=350
OPS_SLOW_SQL_MAX_LOGS_PER_REQUEST=2
OPS_LOG_SLOW_REQUESTS=false
OPS_SLOW_REQUEST_MS=1200
APPCFG_HOME_METRICS_CACHE_SECONDS=0
